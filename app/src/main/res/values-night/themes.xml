<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SparkingPathshala.Starting" parent="Theme.SplashScreen">
        <!-- Force #FFFFFF background in Dark Mode so starting window is NEVER black -->
        <item name="android:windowSplashScreenBackground">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_rounded</item>
        <item name="android:windowSplashScreenAnimationDuration">800</item>

        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_rounded</item>

        <item name="postSplashScreenTheme">@style/Theme.SparkingPathshala</item>
    </style>

    <style name="Theme.SparkingPathshala" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>
